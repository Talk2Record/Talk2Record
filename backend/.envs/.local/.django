# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# WhatsApp Cloud API credentials live in the ``whatsapp`` Integration
# (``Integration.config`` + encrypted ``ApiCredential``), not in env vars.

# AI pipeline
# ------------------------------------------------------------------------------
AI_TRANSCRIPTION_PROVIDER=mock
AI_EXTRACTION_PROVIDER=mock
AI_EXTRACTION_PROMPT_VERSION=v1
AI_USAGE_MONTHLY_LIMIT_PER_ORG=0
INGESTION_DAILY_RECORD_LIMIT_PER_ORG=0
DRF_THROTTLE_ANON=300/min
DRF_THROTTLE_USER=1000/min
DRF_THROTTLE_WHATSAPP_WEBHOOK=120/min
DRF_THROTTLE_PUBLIC_INGESTION=240/min

# Audit retention and sampling
AUDIT_API_KEY_USED_SAMPLE_INTERVAL_MINUTES=5
AUDIT_API_KEY_USED_RETENTION_DAYS=90

