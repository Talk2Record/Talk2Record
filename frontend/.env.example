# App URL (optional). Overrides domain from lib/config/app-main-meta-data.json.
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Django backend base URL used by the frontend API client.
# The client appends `/api` automatically.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# NextAuth (required for Google OAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth – set GOOGLE_CLIENT_ID/SECRET and NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=true to show "Sign in with Google".
# Get credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Single switch for the Google Workspace login flow. When false the button is hidden
# and the NextAuth SessionProvider is not mounted (JWT-first stays canonical).
# The legacy vars (NEXT_PUBLIC_GOOGLE_AUTH_ENABLED, NEXT_PUBLIC_GOOGLE_WORKSPACE_LOGIN)
# are still honoured but deprecated — see docs/AUTH.md.
NEXT_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false

# Comma-separated emails that get admin role when signing in with Google (optional)
# AUTH_ADMIN_EMAILS=admin@yourdomain.com,owner@yourdomain.com
